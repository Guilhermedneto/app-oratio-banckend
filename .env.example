# Copie para .env (nunca versione o .env).
# ambiente: dev ou prod (em produção o segredo JWT é obrigatório)
ENV=dev
DATABASE_URL=postgresql+asyncpg://oratio:oratio@localhost:5433/oratio
# Neon (produção): cole a string COM pooler, como vem do painel (postgresql://…-pooler…?sslmode=require).
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres
JWT_ACCESS_MIN=15
REFRESH_DAYS=30
CORS_ORIGINS=http://localhost:5173
# e-mails (separados por vírgula) que viram gestores ao cadastrar ou entrar
MANAGER_EMAILS=seu-email@exemplo.com
# fontes de leitura, em ordem de tentativa ("sample" gera texto de amostra, só para desenvolvimento)
LITURGY_SOURCES=railway
GOOGLE_CLIENT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
